          <mxGeometry x="160" y="40" width="100" height="40" as="geometry" />
        </mxCell>
        
        <!-- 処理1 -->
        <mxCell id="process1" value="データ入力" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="120" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- 開始 → 処理1 -->
        <mxCell id="edge1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="process1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 判断 -->
        <mxCell id="decision1" value="有効？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="170" y="220" width="80" height="80" as="geometry" />
        </mxCell>
        
        <!-- 処理1 → 判断 -->
        <mxCell id="edge2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="process1" target="decision1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 処理2 (Yes) -->
        <mxCell id="process2" value="データ処理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="150" y="340" width="120" height="60" as="geometry" />
        </mxCell>
        
        <!-- 判断 → 処理2 (Yes) -->
        <mxCell id="edge3" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="decision1" target="process2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- エラー処理 (No) -->
        <mxCell id="error1" value="エラー表示" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="230" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- 判断 → エラー (No) -->
        <mxCell id="edge4" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="decision1" target="error1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- エラー → 処理1 (ループ) -->
        <mxCell id="edge5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="error1" target="process1">
          <mxGeometry relative="1" as="geometry">
